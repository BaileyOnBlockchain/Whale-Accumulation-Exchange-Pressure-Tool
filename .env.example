# Redis (required)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Corpus database path (DuckDB)
CORPUS_DB_PATH=./data/corpus.duckdb

# Chains to track (comma-separated)
TRACKED_CHAINS=ethereum,bitcoin

# Assets to track (comma-separated)
TRACKED_ASSETS=ETH,BTC,USDT,USDC

# Whale threshold: minimum USD balance to qualify as a whale
WHALE_MIN_USD=1000000

# Top-N holders to track per asset
WHALE_TOP_N=200

# How often to re-scan whale balances (seconds)
BALANCE_SCAN_INTERVAL_S=300

# How often to refresh the labeled corpus from external sources (seconds)
CORPUS_REFRESH_INTERVAL_S=3600

# Exchange pressure lookback window for signals (minutes)
FLOW_LOOKBACK_MINUTES=1440

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8001

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Prometheus metrics
METRICS_PORT=9091

# ── External API keys (all optional — free-tier fallbacks exist) ──────────────

# Arkham Intelligence — entity labels (free tier: 10 req/min)
# Sign up: https://platform.arkhamintelligence.com
ARKHAM_API_KEY=

# Dune Analytics — Spellbook address labels (free tier available)
# Sign up: https://dune.com/settings/api
DUNE_API_KEY=

# Etherscan — on-chain balance + tx data (free tier: 5 req/sec)
# Sign up: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Alchemy — Ethereum RPC, enhanced API (free tier: 300M CU/month)
# Sign up: https://www.alchemy.com
ALCHEMY_API_KEY=

# Blockchair — Bitcoin on-chain data (free tier: 30 req/min)
# Sign up: https://blockchair.com/api
BLOCKCHAIR_API_KEY=

# Helius — Solana on-chain data (free tier: 100k credits/month)
# Sign up: https://www.helius.dev
HELIUS_API_KEY=

# CoinGecko — price oracle for USD conversions (free tier: 30 req/min)
# Sign up: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
